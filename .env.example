# Frontend build configuration. These URLs are public and contain no secret.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_RESEARCH_GATEWAY_URL=https://research.market.wowmazingstudios.com

# Backend configuration. Keep credentials in backend/.env or the backend host's
# environment settings; never rename backend secrets with a VITE_ prefix.
MARKET_DATA_PROVIDER=upstox
ALLOW_YFINANCE_FALLBACK=true
UPSTOX_ANALYTICS_TOKEN=your_upstox_access_token_here
OPENAI_API_KEY=your_optional_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost